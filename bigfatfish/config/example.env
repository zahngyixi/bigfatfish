# ==================== DeepSeek API 配置 ====================
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=2000
DEEPSEEK_TEMPERATURE=0.85
DEEPSEEK_STREAM=true

# ==================== Redis 配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ==================== ChromaDB 配置 ====================
CHROMADB_PATH=./data/chromadb
CHROMADB_COLLECTION=bigfatfish_memory

# ==================== 记忆系统参数 ====================
SHORT_MEMORY_WINDOW=10
LONG_MEMORY_TOP_K=5
MEMORY_EXTRACT_INTERVAL=5

# ==================== QQ 接入配置 ====================
QQ_ENABLED=true
# reverse = 本程序监听 3001，NapCat/Lagrange 反向连过来（推荐）
# forward = 本程序主动连接 NapCat/Lagrange 的 WS 服务
QQ_WS_MODE=reverse
QQ_WEBSOCKET_URL=ws://0.0.0.0:3001
QQ_HTTP_URL=http://localhost:3000
QQ_BOT_QQ=123456789
QQ_ADMIN_LIST=987654321,111222333

# 群聊触发关键词（留空则只有 @机器人 触发）
QQ_GROUP_KEYWORDS=大肥鱼,小鱼,AI
# 群聊白名单/黑名单（留空则不限制）
QQ_GROUP_WHITELIST=
QQ_GROUP_BLACKLIST=
# 私聊自动回复
QQ_PRIVATE_AUTO_REPLY=true

# ==================== Bilibili 配置 ====================
BILIBILI_ENABLED=false
BILIBILI_SESSDATA=
BILIBILI_BILI_JCT=
BILIBILI_BUVID3=

# ==================== 频控配置 ====================
FREQUENCY_LIMIT_SECONDS=3
MAX_REPLY_PER_MINUTE=15

# ==================== 语音配置 ====================
ASR_ENABLED=false
ASR_MODEL_PATH=./models/sherpa-onnx

TTS_ENABLED=true
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+0%
TTS_VOLUME=+0%

# ==================== 图像生成配置 ====================
IMAGE_GEN_ENABLED=false
IMAGE_GEN_API_URL=

# ==================== Web UI 配置 ====================
WEB_UI_HOST=0.0.0.0
WEB_UI_PORT=8080

# ==================== 主动交互配置 ====================
ACTIVE_INTERACTION_ENABLED=true
ACTIVE_INTERVAL_HOURS=6

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_PATH=./bigfatfish/logs

# ==================== 人设配置 ====================
PERSONA_NAME=大肥鱼
PERSONA_GENDER=女
PERSONA_AGE=18
